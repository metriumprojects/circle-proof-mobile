{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "production-aab": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "metrium.projects@gmail.com",
        "appleTeamId": "8244GB6YJZ",
        "ascAppId": "6835173961",
        "appName": "Circle Proof",
        "sku": "circleproof-ios",
        "language": "en-US"
      }
    },
    "testflight": {
      "extends": "production"
    }
  }
}
